# Noctusoft store marketplace (see noctusoft-relay docs/api/store/README.md)
NOCTUSOFT_API_KEY=nsins_dk_your_deploy_key_here

# SMS relay inbound webhook HMAC (relay signs POST bodies to /api/webhooks/twilio*)
RELAY_INBOUND_SECRET=whsec_your_relay_inbound_secret_here

# Optional override (default https://api.twilio.noctusoft.com)
# NOCTUSOFT_SMS_RELAY_BASE_URL=https://api.twilio.noctusoft.com
NOCTUSOFT_STORE_BASE_URL=https://api.store.noctusoft.com
NOCTUSOFT_PRODUCT_KEY=fieldview

# Store webhook verification
NOCTUSOFT_WEBHOOK_SECRET=whsec_your_product_webhook_secret_here
FIELDVIEW_WEBHOOK_SECRET=whsec_your_connect_callback_secret_here
FIELDVIEW_WEBHOOK_CALLBACK_URL=http://localhost:4301/api/webhooks/marketplace

# Marketplace platform fee percentage (default 10%)
PLATFORM_FEE_PERCENT=10
