# Noctusoft Relay — Square Connect Hub (see docs/RELAY-CONNECT-HUB-MIGRATION.md)
NOCTUSOFT_API_KEY=nsins_dk_your_deploy_key_here
NOCTUSOFT_RELAY_SQUARE_BASE_URL=https://api.square.noctusoft.com
NOCTUSOFT_PRODUCT_KEY=fieldview

# Route viewer checkout/refunds through the relay (default OFF)
PAYMENTS_VIA_RELAY=false

# Recipient Agreement version recorded on coach connect
RELAY_AGREEMENT_VERSION=v1

# Relay-forwarded webhook verification (HMAC)
FIELDVIEW_WEBHOOK_SECRET=whsec_your_webhook_secret_here
FIELDVIEW_WEBHOOK_CALLBACK_URL=http://localhost:4301/api/webhooks/relay

# Marketplace platform fee percentage (default 10%)
PLATFORM_FEE_PERCENT=10
